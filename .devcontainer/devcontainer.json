{
  "name": "cbc-handson",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 2
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/cbc/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "make -C cbc",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java"
      ]
    }
  }
}
